#!/bin/sh
# Git runs this hook locally before transferring commits.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if ! command -v uv >/dev/null 2>&1; then
  echo "Codex audit pending: uv is unavailable" >&2
  exit 1
fi

uv run --no-sync python tools/codex_pre_push.py --remote "$1"
