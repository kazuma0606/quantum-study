{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project C:/Users/yoshi/quantum python C:/Users/yoshi/quantum/tools/hooks/check_proposal.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --project C:/Users/yoshi/quantum python C:/Users/yoshi/quantum/tools/hooks/check_frozen.py --stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project C:/Users/yoshi/quantum python C:/Users/yoshi/quantum/tools/hooks/check_frozen.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
